+/// Hrana continues after a statement error unless subsequent steps explicitly depend on success.
+/// Guard the watermark and COMMIT too, then roll back any transaction they could not finish.
+fn guard_push_batch(
+    steps: &mut Vec<BatchStep>,
+    ignored_step_indices: &std::collections::HashSet<usize>,
+) -> Result<()> {
+    assert!(!steps.is_empty(), "a push batch starts with BEGIN");
+    let mut previous_required_step = 0;
+    for (i, step) in steps.iter_mut().enumerate().skip(1) {
+        let previous = u32::try_from(previous_required_step).map_err(|_| {
+            Error::DatabaseSyncEngineError(
+                "push batch exceeds Hrana's step index limit".to_string(),
+            )
+        })?;
+        step.condition = Some(BatchCond::And(server_proto::BatchCondList {
+            conds: vec![
+                BatchCond::Not {
+                    cond: Box::new(BatchCond::IsAutocommit {}),
+                },
+                BatchCond::Ok { step: previous },
+            ],
+        }));
+        // ADD COLUMN errors are already treated as nonfatal for idempotent schema replay. A failed
+        // required step before one must still stop the rest of the batch, including its watermark.
+        if !ignored_step_indices.contains(&i) {
+            previous_required_step = i;
+        }
+    }
+    steps.push(BatchStep {
+        condition: Some(BatchCond::Not {
+            cond: Box::new(BatchCond::IsAutocommit {}),
+        }),
+        stmt: Stmt {
+            sql: Some("ROLLBACK".to_string()),
+            sql_id: None,
+            args: Vec::new(),
+            named_args: Vec::new(),
+            want_rows: Some(false),
+            replication_index: None,
+        },
+    });
+    Ok(())
+}
