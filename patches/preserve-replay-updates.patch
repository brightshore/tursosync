+
+async fn merge_replacement_updates<Ctx>(
+    coro: &Coro<Ctx>,
+    generator: &DatabaseReplayGenerator,
+    transaction: Vec<DatabaseTapeRowChange>,
+) -> Result<Vec<DatabaseTapeRowChange>> {
+    let mut normalized = Vec::with_capacity(transaction.len());
+    let mut changes = transaction.into_iter().peekable();
+    while let Some(change) = changes.next() {
+        let merge = if let (DatabaseTapeRowChangeType::Delete { before, key: None }, Some(next)) =
+            (&change.change, changes.peek())
+        {
+            if change.table_name == next.table_name && change.table_name != SQLITE_SCHEMA_TABLE {
+                if let DatabaseTapeRowChangeType::Insert { after } = &next.change {
+                    let info = generator.replay_info(coro, next).await?;
+                    DatabaseReplayGenerator::same_primary_key(
+                        &info, before, change.id, after, next.id,
+                    )
+                } else {
+                    false
+                }
+            } else {
+                false
+            }
+        } else {
+            false
+        };
+        if merge {
+            let DatabaseTapeRowChangeType::Delete { before, .. } = change.change else {
+                unreachable!()
+            };
+            let next = changes.next().unwrap();
+            let DatabaseTapeRowChangeType::Insert { after } = next.change else {
+                unreachable!()
+            };
+            normalized.push(DatabaseTapeRowChange {
+                change: DatabaseTapeRowChangeType::Update {
+                    before,
+                    after,
+                    updates: None,
+                },
+                ..next
+            });
+        } else {
+            normalized.push(change);
+        }
+    }
+    Ok(normalized)
 }
 
