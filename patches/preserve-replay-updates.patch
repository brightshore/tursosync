     /// Returns which columns can be INSERTed or UPDATEd, skipping generated columns.
     /// Returns `(Vec<col_name>, Vec<pk_column_indices>, Option<rowid_alias_pk_column_index>)`
+    pub(crate) fn same_primary_key(
+        info: &ReplayInfo,
+        before: &[turso_core::Value],
+        before_rowid: i64,
+        after: &[turso_core::Value],
+        after_rowid: i64,
+    ) -> bool {
+        let Some(columns) = info.pk_column_indices.as_ref().filter(|p| !p.is_empty()) else {
+            return false;
+        };
+        columns.iter().all(|&column| {
+            if Some(column) == info.rowid_alias_pk_column_index {
+                before_rowid == after_rowid
+            } else {
+                matches!((before.get(column), after.get(column)), (Some(a), Some(b)) if !matches!(a, turso_core::Value::Null) && a == b)
+            }
+        })
+    }
