+    pub(crate) async fn page_matches<Ctx>(
+        &self,
+        coro: &Coro<Ctx>,
+        page_no: u32,
+        page: &[u8],
+        current: &mut [u8],
+    ) -> Result<bool> {
+        if page.len() != self.page_size {
+            return Err(Error::DatabaseTapeError(format!(
+                "page.len() must be equal to page_size: {} != {}",
+                page.len(),
+                self.page_size
+            )));
+        }
+        if let Some((prepared_page_no, frame)) = &self.prepared_frame {
+            if *prepared_page_no == page_no {
+                return Ok(&frame[WAL_FRAME_HEADER..] == page);
+            }
+        }
+        let exists = try_wal_watermark_read_page(
+            coro,
+            self.wal_session.conn(),
+            page_no,
+            current,
+            Some(self.next_wal_frame_no - 1),
+        )
+        .await?;
+        Ok(exists && current == page)
     }
 
