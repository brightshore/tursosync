+/// Preserve the local CDC transaction boundaries while a pull itself remains atomic.
+/// Committing the SQL connection between replayed transactions would expose a partial
+/// pull. Instead, recapture the logical COMMIT records inside the one apply transaction.
+#[derive(Default)]
+struct LocalReplayTransactions {
+    ends: BTreeSet<i64>,
+    last_collected: Option<i64>,
+    last_replayed: Option<i64>,
+}
+
+impl LocalReplayTransactions {
+    fn observe(&mut self, operation: &DatabaseTapeOperation) {
+        match operation {
+            DatabaseTapeOperation::RowChange(change) => {
+                self.last_collected = Some(change.change_id)
+            }
+            DatabaseTapeOperation::Commit => {
+                if let Some(id) = self.last_collected.take() {
+                    self.ends.insert(id);
+                }
+            }
+            _ => {}
+        }
+    }
+
+    async fn before_replay<Ctx>(
+        &mut self,
+        coro: &Coro<Ctx>,
+        conn: &Arc<turso_core::Connection>,
+        change_id: i64,
+    ) -> Result<()> {
+        if let Some(previous) = self.last_replayed {
+            // A transform or an internal-table filter may remove the final row
+            // of a transaction; retain its boundary before the next surviving row.
+            if self.ends.range(previous..change_id).next().is_some() {
+                Self::finish(coro, conn).await?;
+            }
+        }
+        self.last_replayed = Some(change_id);
+        Ok(())
+    }
+
+    async fn finish<Ctx>(coro: &Coro<Ctx>, conn: &Arc<turso_core::Connection>) -> Result<()> {
+        let info = conn.get_capture_data_changes_info().clone();
+        let Some(info) = info.filter(|info| info.cdc_version().has_commit_record()) else {
+            return Ok(());
+        };
+        let txn_id = conn.get_cdc_transaction_id();
+        if txn_id < 0 {
+            return Ok(());
+        }
+        // Writing the CDC table itself is not captured. This is a logical marker,
+        // not SQL COMMIT: an apply error still rolls back every replayed row.
+        let table = info.table.replace('"', "\"\"");
+        let mut stmt = conn.prepare(&format!(
+            "INSERT INTO \"{table}\" (change_time, change_txn_id, change_type) VALUES (unixepoch(), {txn_id}, 2)"
+        ))?;
+        run_stmt_ignore_rows(coro, &mut stmt).await?;
+        conn.set_cdc_transaction_id(-1);
+        Ok(())
+    }
+}
