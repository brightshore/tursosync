<Project>

  <!-- Shared settings + NuGet package metadata for the TursoSync package family: a standalone Turso
       provider (namespace `Turso.Sync`) that adds local↔cloud sync and tantivy FTS on top of the official
       Turso.Data surface, plus optional DbUp and Dapper integration packages. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.8.1</Version>
    <Authors>John Campion Jr</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/brightshore/tursosync</PackageProjectUrl>
    <RepositoryUrl>https://github.com/brightshore/tursosync</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>turso;sqlite;libsql;sync;ado.net;database;fts</PackageTags>
  </PropertyGroup>

  <!-- Pack the shared README into every package (only for packable projects). -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>

